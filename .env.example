# ---------------------------------------------------------------
# Firebase web config (safe to expose in the browser bundle).
# Get these from Firebase Console > Project settings > Your apps.
# NEVER put a Firebase Admin SDK private key / service account JSON here.
# ---------------------------------------------------------------
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: base path when hosting on GitHub Pages project site, e.g. /srsrp-web/
VITE_BASE_PATH=/
