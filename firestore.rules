rules_version = '2';

// ============================================================================
// শেখ রাসেল জাতীয় শিশু-কিশোর পরিষদ — ৫নং রামচন্দ্রকুড়া ইউনিয়ন শাখা
// Firestore Security Rules — deny by default, server-enforced role checks.
//
// Roles: super_admin > admin > editor > member
//   member      : own profile + own private contact only
//   editor      : publish/edit content (notices, events, activities, gallery, committees)
//   admin       : editor + member records, applications, messages, audit log
//   super_admin : admin + role changes + deletes
//
// The role is read from users/{uid}.role — never from anything the client sends.
// Cloud Functions are not used (Spark plan), so these rules ARE the enforcement layer.
// ============================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------
    function signedIn() {
      return request.auth != null;
    }

    function myData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isActive() {
      return signedIn() && myData().status == 'active';
    }

    function isStaff() {
      return isActive() && myData().role in ['super_admin', 'admin', 'editor'];
    }

    function isAdmin() {
      return isActive() && myData().role in ['super_admin', 'admin'];
    }

    function isSuperAdmin() {
      return isActive() && myData().role == 'super_admin';
    }

    function changed(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function isPublishedRead() {
      return resource.data.published == true;
    }

    // ---------- users ----------
    match /users/{uid} {
      // own account, staff/administration, or a published public directory entry
      allow read: if (signedIn() && request.auth.uid == uid)
                  || isAdmin()
                  || (isPublishedRead() && resource.data.role == 'member');

      // self signup only: role "member", status "pending", never published
      allow create: if signedIn()
                    && request.auth.uid == uid
                    && request.resource.data.uid == uid
                    && request.resource.data.role == 'member'
                    && request.resource.data.status == 'pending'
                    && request.resource.data.published == false;

      allow update: if
        // super admin: anything except rewriting the identity
        (isSuperAdmin() && request.resource.data.uid == resource.data.uid)
        // admin: manage members, but never promote/demote
        || (isAdmin()
            && request.resource.data.uid == resource.data.uid
            && !changed(['role', 'uid', 'createdAt']))
        // member: own profile fields only
        || (signedIn()
            && request.auth.uid == uid
            && !changed(['role', 'status', 'published', 'memberCode', 'approvedBy', 'approvedAt', 'uid', 'createdAt']));

      allow delete: if isSuperAdmin();

      // private contact data (phone, email, guardian, date of birth)
      match /private/{privateDoc} {
        allow read, write: if (signedIn() && request.auth.uid == uid) || isAdmin();
      }
    }

    // ---------- membership applications ----------
    match /membershipApplications/{applicationId} {
      // public form: validated, always pending, never pre-approved
      allow create: if request.resource.data.status == 'pending'
                    && request.resource.data.fullName is string
                    && request.resource.data.fullName.size() >= 2
                    && request.resource.data.fullName.size() <= 120
                    && request.resource.data.phone is string
                    && request.resource.data.phone.size() >= 6
                    && request.resource.data.phone.size() <= 20
                    && (!('uid' in request.resource.data)
                        || (signedIn() && request.resource.data.uid == request.auth.uid))
                    && (!('motivation' in request.resource.data)
                        || request.resource.data.motivation.size() <= 2000);

      allow read: if isAdmin();

      // review only: the applicant's own statements stay immutable
      allow update: if isAdmin()
                    && !changed(['fullName', 'phone', 'uid', 'createdAt', 'email']);

      allow delete: if isSuperAdmin();
    }

    // ---------- organizational content (publish = editor+) ----------
    match /committees/{docId} {
      allow read: if isPublishedRead() || isStaff();
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      // editors may edit any organizational content, but authorship cannot be rewritten
      allow update: if isStaff() && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    match /notices/{docId} {
      allow read: if isPublishedRead() || isStaff();
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      // editors may edit any organizational content, but authorship cannot be rewritten
      allow update: if isStaff() && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    match /events/{docId} {
      allow read: if isPublishedRead() || isStaff();
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      // editors may edit any organizational content, but authorship cannot be rewritten
      allow update: if isStaff() && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    match /activities/{docId} {
      allow read: if isPublishedRead() || isStaff();
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      // editors may edit any organizational content, but authorship cannot be rewritten
      allow update: if isStaff() && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    match /gallery/{docId} {
      allow read: if isPublishedRead() || isStaff();
      allow create: if isStaff() && request.resource.data.createdBy == request.auth.uid;
      // editors may edit any organizational content, but authorship cannot be rewritten
      allow update: if isStaff() && request.resource.data.createdBy == resource.data.createdBy;
      allow delete: if isAdmin();
    }

    // ---------- contact form ----------
    match /contactMessages/{docId} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() >= 2
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.subject is string
                    && request.resource.data.subject.size() <= 200
                    && request.resource.data.message is string
                    && request.resource.data.message.size() >= 2
                    && request.resource.data.message.size() <= 4000
                    && request.resource.data.handled == false;

      allow read, update: if isAdmin();
      allow delete: if isSuperAdmin();
    }

    // ---------- audit trail (append-only) ----------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isStaff() && request.resource.data.actorUid == request.auth.uid;
      allow update, delete: if false;
    }

    // ---------- settings ----------
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ---------- everything else is closed ----------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
